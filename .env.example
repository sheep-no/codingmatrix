# =============================================================================
# AI Agent 环境变量配置（2核4G 服务器优化版）
# =============================================================================

# -----------------------------------------------------------------------------
# 必需配置
# -----------------------------------------------------------------------------

# JWT 密钥（生产环境必须使用强随机密钥）
SECRET_KEY=your-super-secret-key-change-in-production

# 硅基流动 API Key
SILICONFLOW_API_KEY=your-siliconflow-api-key

# -----------------------------------------------------------------------------
# 服务器配置
# -----------------------------------------------------------------------------

# 运行环境 (development/production)
ENV=production

# 允许的 hosts（逗号分隔）
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS 源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 数据库配置（2核4G 优化）
# -----------------------------------------------------------------------------

# 数据库 URL（SQLite 适用于中小型项目）
DATABASE_URL=sqlite+aiosqlite:///./app.db

# 连接池大小（2核CPU建议 3-5）
DB_POOL_SIZE=3

# 最大溢出连接（高峰期额外连接数）
DB_MAX_OVERFLOW=5

# -----------------------------------------------------------------------------
# Redis + Celery 配置（任务队列）
# -----------------------------------------------------------------------------

# Redis URL（必须，Celery broker）
REDIS_URL=redis://localhost:6379/0

# Celery 并发数（2核4G建议 1-2）
CELERY_CONCURRENCY=1

# Celery 单 worker 最大任务数（防止内存泄漏）
CELERY_MAX_TASKS_PER_CHILD=50

# 任务超时时间（秒）
TASK_TIME_LIMIT=300
TASK_SOFT_TIME_LIMIT=270

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=WARNING

# 日志保留天数
LOG_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# 性能优化配置（2核4G 服务器）
# -----------------------------------------------------------------------------

# WebSocket 最大连接数（防止连接过多耗尽内存）
WS_MAX_CONNECTIONS=50

# 文件上传大小限制 (MB)
MAX_UPLOAD_SIZE_MB=50

# -----------------------------------------------------------------------------
# 优雅关闭配置
# -----------------------------------------------------------------------------

# 关闭超时时间（秒）
GRACEFUL_SHUTDOWN_TIMEOUT=30

# WebSocket 关闭超时（秒）
WEBSOCKET_DRAIN_TIMEOUT=10

# Celery 关闭超时（秒）
CELERYD_SIGTERM_TIMEOUT=20

# -----------------------------------------------------------------------------
# Nginx 配置（反向代理 + 前端静态文件）
# -----------------------------------------------------------------------------

# Nginx 静态文件目录（前端 npm run build 后的 dist 目录）
NGINX_STATIC_ROOT=/workspace/src/dist

# Nginx 最大上传大小（需与 MAX_UPLOAD_SIZE_MB 一致）
NGINX_CLIENT_MAX_BODY_SIZE=100m

# -----------------------------------------------------------------------------
# AI 模型配置
# -----------------------------------------------------------------------------

# 允许使用的模型（逗号分隔）
ALLOWED_MODELS=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B,deepseek-ai/DeepSeek-OCR,Qwen/Qwen3.5-4B,Qwen/Qwen3-8B,Qwen/Qwen2.5-7B-Instruct,THUDM/GLM-4.1V-9B-Thinking,THUDM/GLM-4-9B-0414,THUDM/GLM-Z1-9B-0414,Kwai-Kolors/Kolors

# 多供应商 API Keys（可选，系统会自动路由到已配置的供应商）

# SiliconFlow（默认供应商，支持所有上述 10 个内置模型）
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 阿里百炼（支持 qwen-plus、qwen-turbo、qwen-max 等 Qwen 系列模型）
# DASHSCOPE_API_KEY=your-dashscope-api-key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱 GLM（支持 glm-4、glm-4v 等 GLM 系列模型）
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# DeepSeek 官方（支持 deepseek-chat、deepseek-reasoner）
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI（支持 gpt-4o、gpt-4o-mini 等）
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude（支持 claude-3-5-sonnet、claude-3-opus 等）
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Ollama（本地部署模型，无需 API Key）
# OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Sentry 错误追踪（可选）
# -----------------------------------------------------------------------------

# Sentry DSN（生产环境建议配置）
# SENTRY_DSN=https://example@sentry.io/1234567

# Sentry 环境
# SENTRY_ENVIRONMENT=production