# 生产环境配置示例
# 复制为 .env 使用

# 生产环境
ENV=production

# 安全配置（必须修改）
SECRET_KEY=your-super-secret-key-change-in-production
SILICONFLOW_API_KEY=sk-your-actual-api-key

# 数据库（建议用 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# 数据库连接池（生产环境加大）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# 日志
LOG_LEVEL=INFO

# API 配置
ALLOWED_HOSTS=your-domain.com,api.your-domain.com
CORS_ORIGINS=https://your-domain.com

# 模型配置
# 模型分工说明：
# - deepseek-ai/DeepSeek-R1-0528-Qwen3-8B: 代码生成、复杂逻辑推理（主力）
# - deepseek-ai/DeepSeek-OCR: OCR 文字识别（专用）
# - Qwen/Qwen3.5-4B: 轻量级文本生成、快速响应
# - Qwen/Qwen3-8B: 通用文本生成、文档处理、图像描述
# - Qwen/Qwen2.5-7B-Instruct: 指令遵循、对话交互、代码生成
# - THUDM/GLM-4.1V-9B-Thinking: 视觉理解、图像分析（主力）
# - Kwai-Kolors/Kolors: 图像生成、AI 绘画
ALLOWED_MODELS=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B,deepseek-ai/DeepSeek-OCR,Qwen/Qwen3.5-4B,Qwen/Qwen3-8B,Qwen/Qwen2.5-7B-Instruct,THUDM/GLM-4.1V-9B-Thinking,Kwai-Kolors/Kolors

# Redis 缓存（可选）
REDIS_URL=redis://localhost:6379/0
