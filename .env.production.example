# 生产环境配置示例
# 复制为 .env 使用

# 生产环境
ENV=production

# 安全配置（必须修改）
SECRET_KEY=your-super-secret-key-change-in-production
SILICONFLOW_API_KEY=sk-your-actual-api-key

# 监控抓取与告警回调令牌（启用 observability profile 时必填，至少 16 字符）
# METRICS_TOKEN=your-metrics-token-change-in-production

# 告警转发（可选）：IM Webhook 支持 generic/feishu/dingtalk/wecom/slack
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# ALERT_WEBHOOK_TYPE=feishu
# ALERT_NOTIFY_MIN_SEVERITY=warning

# 告警邮件（可选）：主机、发件人与收件人齐全才会发送
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_SECURITY=starttls
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_FROM=alerts@example.com
# ALERT_SMTP_TO=oncall@example.com

# RSA 私钥落盘口令（可选）：设置后私钥以口令加密，留空保持明文
# RSA_KEY_PASSPHRASE=your-rsa-key-passphrase

# 数据库（建议用 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# 数据库连接池（生产环境加大）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# 日志
LOG_LEVEL=INFO

# API 配置
ALLOWED_HOSTS=your-domain.com,api.your-domain.com
CORS_ORIGINS=https://your-domain.com

# 模型配置：可用模型与默认分工由 data/unified_model_config.yaml 与代码内的
# MODEL_REGISTRY 定义，无需通过环境变量配置白名单
# Redis 缓存（可选）
REDIS_URL=redis://localhost:6379/0
