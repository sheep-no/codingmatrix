  "key_decisions": [
    {"question": "编辑器类型？", "impact": "frontend", "options": ["Markdown（开发者友好）", "富文本WYSIWYG（普通用户友好）"]},
    {"question": "内容审核流程？", "impact": "workflow", "options": ["无审核（直接发布）", "编辑提交→审核→发布"]},
    {"question": "分类结构？", "impact": "data_model", "options": ["平铺分类（简单）", "树形分类（灵活但查询复杂）"]}
  ]
