    {"question": "是否需要跨行转账？", "impact": "architecture", "options": ["仅行内转账（简单）", "跨行转账（需对接网关+异步回调）"]},
    {"question": "金额精度用什么类型？", "impact": "data_model", "options": ["Decimal（精确）", "Float（简单但可能丢精度）"]},
