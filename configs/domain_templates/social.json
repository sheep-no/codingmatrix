{
  "domain": "social",
  "version": "1.0",
  "description": "社交/聊天应用领域模板",
  "applicable_project_types": ["medium", "large", "enterprise"],
  "core_modules": [
    {"name": "用户系统", "category": "core", "impact": "基础", "options": ["简单注册", "注册+头像+个人资料"], "default": "注册+资料"},
    {"name": "消息系统", "category": "core", "impact": "核心功能", "options": ["文本消息", "文本+图片+文件"], "default": "文本+图片"},
    {"name": "关注/好友", "category": "core", "impact": "社交关系", "options": ["单向关注", "双向好友"], "default": "双向好友"},
    {"name": "动态/朋友圈", "category": "core", "impact": "内容分享", "options": ["无", "动态发布+点赞+评论"], "default": "动态发布+点赞"},
    {"name": "通知系统", "category": "core", "impact": "互动", "options": ["站内通知", "站内+推送"], "default": "站内通知"},
    {"name": "群组功能", "category": "optional", "impact": "社交扩展", "options": ["无", "群聊+群管理"], "default": "无"},
    {"name": "搜索功能", "category": "optional", "impact": "内容检索", "options": ["无", "用户+内容搜索"], "default": "无"},
    {"name": "黑名单/隐私", "category": "optional", "impact": "安全", "options": ["无", "黑名单+隐私设置"], "default": "黑名单+隐私"}
  ],
  "non_functional_requirements": [
    {"category": "performance", "item": "消息实时推送延迟<1s", "priority": "high"},
    {"category": "performance", "item": "高并发消息处理", "priority": "high"},
    {"category": "security", "item": "消息内容过滤", "priority": "medium"},
    {"category": "reliability", "item": "消息不丢失", "priority": "high"}
  ],
  "common_pitfalls": [
    "消息实时推送需要WebSocket或长轮询，HTTP请求方式不够实时",
    "消息存储量增长快，需要分表或归档策略",
    "社交关系图查询（共同好友、推荐）性能挑战大",
    "动态Feed流需要考虑时间排序和关注筛选",
    "隐私设置需要细粒度控制（谁可以看我的动态/资料）"
  ],
  "key_decisions": [
    {"question": "消息推送方式？", "impact": "architecture", "options": ["WebSocket（实时）", "长轮询（兼容性好）", "SSE（单向推送）"]},
    {"question": "社交关系模式？", "impact": "data_model", "options": ["单向关注（像微博）", "双向好友（像微信）"]},
    {"question": "Feed流排序？", "impact": "performance", "options": ["时间排序（简单）", "算法推荐（复杂但体验好）"]}
  ]
}